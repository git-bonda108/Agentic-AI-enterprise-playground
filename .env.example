# Copy to .env and fill in what you use. Never commit .env.

# ---- Web (apps/web) ----
AUTH_SECRET=replace-with-a-long-random-string
# Microsoft Entra ID. Leave empty to use the seeded development users.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Show the seeded development sign-in buttons (development only).
ALLOW_DEV_LOGIN=true
# Where the web app reaches the API. PLAYGROUND_API_URL is read at runtime, NEXT_PUBLIC_API_URL at build time.
PLAYGROUND_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Shared secret between the web app's route handlers and the API. Must match on both sides.
PLAYGROUND_INTERNAL_KEY=local-internal-key

# ---- API (apps/api) ----
# PLAYGROUND_DATABASE_URL=postgresql+psycopg://playground:playground@localhost:5432/playground
# PLAYGROUND_FAKE_LLM=true            # deterministic offline provider for tests and demos
# PLAYGROUND_SANDBOX_ENDPOINT=        # Azure Container Apps dynamic sessions pool endpoint
# PLAYGROUND_SELF_URL=http://localhost:8000

# ---- Model providers (any subset; a model shows as unavailable until its key is set) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
GROQ_API_KEY=

# ---- Optional ----
LITELLM_MASTER_KEY=sk-local-dev        # only for the optional LiteLLM proxy in infra/docker-compose.yml
# Personal provider keys are encrypted at rest with this Fernet key. Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required outside local environments. Locally a key derived from PLAYGROUND_INTERNAL_KEY is used when this is empty.
PLAYGROUND_KEY_ENCRYPTION_KEY=

# ---- Platform provider keys (hidden from people; they can add their own from the Keys drawer) ----
NVIDIA_NIM_API_KEY=                    # https://build.nvidia.com/settings/api-keys (Nemotron, Hermes and the NIM shelf)
MISTRAL_API_KEY=                       # https://console.mistral.ai/api-keys
XAI_API_KEY=                           # https://console.x.ai/
COHERE_API_KEY=                        # https://dashboard.cohere.com/api-keys
GITHUB_TOKEN=                          # only for scripts/import_catalog.py (catalog refresh)
